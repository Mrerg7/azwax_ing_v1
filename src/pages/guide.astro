---
import MainLayout from '../layouts/MainLayout.astro';

const title = 'How to Acquire azwax.ing | Premium Domain Buyer Guide';
const description =
  'How a qualified buyer acquires azwax.ing: inquiry, terms, Escrow.com settlement, and registrar transfer. Price on request.';

const sections = [
  ['What you are actually buying', 'azwax.ing is five letters plus a verb-like extension. AZ is the state. Wax is the service. Together they are short enough to say out loud and specific enough that a stranger understands the business. You are buying the string, the right to point it at your brand, and the head start that comes from not having to explain the name.'],
  ['What makes a name like this scarce', 'Dictionary keywords on short .coms are mostly gone. Newer extensions still have exact matches, but few combine a state code, a commercial service word, and a five-letter stem. Once this string has an operator behind it, the exact brand is not available to the next salon group.'],
  ['How price is set', 'There is no public buy-it-now figure on purpose. Comparable sales, the buyer’s plan, and how cleanly the name fits that plan all move the number. Send a range if you have one. A note that names the city, the format, and a timeline is easier to answer than a blank “make offer.”'],
  ['The path from note to nameservers', 'A useful inquiry includes your name, a working email, the intended use, and whether you want an outright purchase. We reply with a structure. If both sides agree, the domain and the funds go through Escrow.com. After release, the name moves by registrar push or authorization code. Most transfers finish in a few business days.'],
  ['What this page will not do', 'It will not invent testimonials, flash a fake viewer count, or run a countdown on a domain that is not expiring. One name, one owner, a direct conversation.'],
];

const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'azwax.ing', item: 'https://azwax.ing/' },
    { '@type': 'ListItem', position: 2, name: 'Buyer guide', item: 'https://azwax.ing/guide/' },
  ],
};
---

<MainLayout title={title} description={description} path="/guide/">
  <main id="content" class="mx-auto max-w-3xl px-4 py-14 pb-28 md:px-6 md:py-20">
    <p class="text-xs font-semibold uppercase tracking-widest text-desert-terracotta">Buyer guide</p>
    <h1 class="mt-3 font-serif text-4xl md:text-6xl">How to acquire azwax.ing</h1>
    <p class="mt-5 text-lg text-desert-sage">
      A straight account of the asset, the close, and what a serious note looks like.
      <a href="/" class="font-medium text-desert-charcoal underline-offset-4 hover:underline">Return to the domain</a>.
    </p>
    <div class="mt-10 space-y-10">
      {sections.map(([heading, body]) => (
        <section>
          <h2 class="font-serif text-3xl">{heading}</h2>
          <p class="mt-3 text-base leading-relaxed text-desert-sage">{body}</p>
        </section>
      ))}
    </div>
    <div class="mt-12 rounded-3xl bg-desert-night p-6 text-desert-night-fg md:p-8">
      <h2 class="font-serif text-3xl">Ready to write</h2>
      <p class="mt-2 text-sm text-desert-night-fg/75">Use the inquiry on the home page, or email sales@desertrich.com.</p>
      <a href="/#acquire" class="mt-6 inline-flex min-h-12 items-center rounded-full bg-desert-paper px-5 text-sm font-semibold text-desert-charcoal">Make an offer</a>
    </div>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(crumbs)} />
</MainLayout>
