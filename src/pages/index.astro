---
import MainLayout from '../layouts/MainLayout.astro';

const why = [
  ['Statewide Arizona authority', 'AZ reads instantly as the Grand Canyon State — Phoenix, Scottsdale, Tucson, and every growing community in between.'],
  ['A verb-driven .ing', 'The extension implies action: waxing, smoothing, becoming. It stands apart from a crowded .com shelf.'],
  ['High-intent keywords', 'Wax plus a clear geography lines up with searches for Arizona waxing, body waxing, and professional hair removal.'],
  ['Built to stretch', 'Flagship salon, multi-location group, mobile service, booking network, academy, or a product line — the name holds.'],
  ['A defensible moat', 'Five letters, one meaning, one owner. Competitors cannot copy the exact string.'],
  ['Trust on day one', 'A precise geo-plus-service name shortens the explanation. People already understand what the brand does.'],
];

const uses = [
  ['Salon', 'Flagship or multi-location salon', 'Open as Arizona’s waxing name, then carry the same mark from Phoenix to Scottsdale and beyond.'],
  ['Mobile', 'Concierge and in-home service', 'Short enough for a booking link, clear enough for event cards and on-demand routes.'],
  ['Platform', 'Statewide booking directory', 'The hub that matches clients with vetted estheticians — one address for the whole state.'],
  ['Academy', 'Training and certification brand', 'Teach the craft under a name that already sounds like the Arizona standard.'],
  ['Product', 'Wax, oil, and aftercare line', 'Put hard wax, oils, and aftercare under a brand rooted in the market that will use them.'],
  ['Franchise', 'Regional or national concept', 'Start with an Arizona flagship identity, then extend the operating system to the next city.'],
];

const facts = [
  ['Name', 'azwax.ing'],
  ['Length', '5 letters + .ing'],
  ['Category', 'Geo + service'],
  ['Status', 'Available'],
  ['Price', 'On request'],
  ['Settlement', 'Escrow.com'],
];

const steps = [
  ['01', 'Inquire', 'Share who you are, how you would use the name, and a range if you have one.'],
  ['02', 'Structure', 'We answer with terms that fit the buyer. No public auction and no countdown.'],
  ['03', 'Escrow', 'Funds and the domain move together through Escrow.com.'],
  ['04', 'Transfer', 'Registrar push or auth code, typically within a few business days.'],
];
---

<MainLayout path="/">
  <main id="content" class="pb-24 md:pb-0">
    <section class="mx-auto grid max-w-6xl items-end gap-10 px-4 pb-8 pt-12 md:grid-cols-12 md:px-6 md:pb-16 md:pt-20">
      <div class="md:col-span-7">
        <p class="text-xs font-semibold uppercase tracking-widest text-desert-terracotta">Premium · Rare · One of a kind</p>
        <h1 class="mt-4 font-serif text-6xl leading-none tracking-tight sm:text-7xl md:text-8xl">azwax.ing</h1>
        <p class="mt-5 max-w-xl text-xl font-medium leading-snug text-desert-sage md:text-2xl">
          Arizona’s definitive domain for professional waxing and hair removal.
        </p>
        <p class="mt-4 max-w-lg text-base text-desert-muted">
          A modern .ing that pairs a state abbreviation with the service people already search for. Instant authority, statewide reach.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="#acquire" class="cta-primary inline-flex min-h-12 items-center justify-center rounded-full px-6 text-base font-semibold">Inquire to acquire</a>
          <a href="#why" class="inline-flex min-h-12 items-center justify-center rounded-full border border-desert-border bg-desert-paper px-6 text-base font-semibold">See why it is scarce</a>
        </div>
      </div>
      <aside class="rounded-3xl border border-desert-border bg-desert-paper p-6 md:col-span-5">
        <div class="flex items-baseline justify-between gap-3">
          <p class="text-sm font-medium text-desert-muted">Asking price</p>
          <p class="rounded-full bg-desert-cream px-3 py-1 text-xs font-semibold uppercase tracking-wide text-desert-terracotta">One available</p>
        </div>
        <p class="mt-2 font-serif text-4xl">On request</p>
        <p class="mt-1 text-sm text-desert-muted">Quoted to qualified buyers. Not listed as a bargain bin.</p>
        <dl class="mt-6 divide-y divide-desert-border border-y border-desert-border">
          {facts.map(([label, value]) => (
            <div class="flex items-center justify-between gap-4 py-3 text-sm">
              <dt class="text-desert-muted">{label}</dt>
              <dd class="text-right font-medium">{value}</dd>
            </div>
          ))}
        </dl>
        <a href="#acquire" class="mt-6 flex min-h-12 items-center justify-center rounded-full bg-desert-charcoal text-sm font-semibold text-desert-sand">Make an offer</a>
      </aside>
    </section>

    <section class="border-y border-desert-border bg-desert-paper" aria-label="Transfer assurances">
      <ul class="mx-auto grid max-w-6xl gap-4 px-4 py-5 sm:grid-cols-3 md:px-6">
        <li class="py-2"><p class="text-sm font-semibold">Escrow settlement</p><p class="text-sm text-desert-muted">Money and the name move together.</p></li>
        <li class="py-2"><p class="text-sm font-semibold">Clean transfer</p><p class="text-sm text-desert-muted">Registrar push or auth code.</p></li>
        <li class="py-2"><p class="text-sm font-semibold">HTTPS by default</p><p class="text-sm text-desert-muted">Canonical host is forced to https://azwax.ing.</p></li>
      </ul>
    </section>

    <section id="why" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-16 md:px-6 md:py-24">
      <p class="text-xs font-semibold uppercase tracking-widest text-desert-terracotta">Strategic advantage</p>
      <h2 class="mt-3 max-w-xl font-serif text-4xl md:text-5xl">Why azwax.ing is a rare premium asset</h2>
      <p class="mt-4 max-w-lg text-desert-sage">Geography, the service keyword, and a modern extension — in one string.</p>
      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {why.map(([title, body]) => (
          <article class="value-card rounded-3xl border border-desert-border bg-desert-paper p-6">
            <h3 class="font-serif text-2xl">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-desert-sage">{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="market" class="scroll-mt-24 border-y border-desert-border bg-desert-paper">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 md:grid-cols-12 md:px-6 md:py-24">
        <div class="md:col-span-7">
          <p class="text-xs font-semibold uppercase tracking-widest text-desert-terracotta">Growing market</p>
          <h2 class="mt-3 font-serif text-4xl md:text-5xl">Arizona’s beauty and grooming economy</h2>
          <p class="mt-5 text-desert-sage">
            Population growth, tourism, and a desert climate keep demand steady for professional hair removal. Phoenix is the center of gravity. Scottsdale adds a luxury tier. Tucson and the surrounding cities keep the map wide.
          </p>
          <p class="mt-4 text-desert-sage">
            Warm weather, fitness culture, and year-round visitors support body, facial, and specialized waxing — including a rising share of male grooming.
          </p>
        </div>
        <div class="rounded-3xl border border-desert-border bg-desert-sand p-6 md:col-span-5">
          <p class="text-sm text-desert-muted">U.S. hair removal market, industry estimates</p>
          <p class="mt-2 font-serif text-5xl tabular-nums">~$416M</p>
          <p class="mt-1 text-sm text-desert-terracotta">2025 snapshot · roughly 6% CAGR cited through 2034</p>
          <p class="mt-4 text-xs leading-relaxed text-desert-muted">
            Figures are publicly discussed estimates, not a forecast for this domain. They describe the category the name sits in.
          </p>
          <ul class="mt-6 space-y-2 text-sm text-desert-sage">
            <li>Fast in-migration and a growing metro</li>
            <li>Tourism and hospitality that never fully pause</li>
            <li>Outdoor life in a warm climate</li>
            <li>More men booking grooming, not only women</li>
          </ul>
        </div>
      </div>
    </section>

    <section id="uses" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-16 md:px-6 md:py-24">
      <p class="text-xs font-semibold uppercase tracking-widest text-desert-terracotta">Endless possibilities</p>
      <h2 class="mt-3 font-serif text-4xl md:text-5xl">Built for operators, not squatters</h2>
      <p class="mt-4 max-w-lg text-desert-sage">The same name, six ways it earns its keep.</p>
      <div class="mt-6 flex gap-2 overflow-x-auto pb-1" id="use-filters" role="tablist" aria-label="Use cases">
        {['All', 'Salon', 'Mobile', 'Platform', 'Academy', 'Product', 'Franchise'].map((tag, i) => (
          <button type="button" role="tab" data-filter={tag} aria-selected={i === 0 ? 'true' : 'false'} class:list={['min-h-12 shrink-0 rounded-full px-4 text-sm font-medium', i === 0 ? 'bg-desert-charcoal text-desert-sand' : 'bg-desert-cream text-desert-sage']}>
            {tag}
          </button>
        ))}
      </div>
      <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3" id="use-grid">
        {uses.map(([tag, title, body]) => (
          <article data-tag={tag} class="rounded-3xl border border-desert-border bg-desert-paper p-6">
            <p class="text-xs font-semibold uppercase tracking-widest text-desert-terracotta">{tag}</p>
            <h3 class="mt-2 font-serif text-xl">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-desert-sage">{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="border-t border-desert-border bg-desert-cream">
      <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
        <p class="text-xs font-semibold uppercase tracking-widest text-desert-terracotta">The close</p>
        <h2 class="mt-3 font-serif text-4xl md:text-5xl">Four steps. No theater.</h2>
        <ol class="mt-10 grid gap-4 md:grid-cols-4">
          {steps.map(([n, title, body]) => (
            <li class="rounded-3xl border border-desert-border bg-desert-paper p-5">
              <p class="font-serif text-3xl tabular-nums text-desert-terracotta">{n}</p>
              <h3 class="mt-3 font-serif text-2xl">{title}</h3>
              <p class="mt-2 text-sm text-desert-sage">{body}</p>
            </li>
          ))}
        </ol>
        <p class="mt-8 text-sm text-desert-muted">
          Want the longer version? <a href="/guide/" class="font-medium text-desert-charcoal underline-offset-4 hover:underline">Read the buyer guide</a>.
        </p>
      </div>
    </section>

    <section id="acquire" class="scroll-mt-24 bg-desert-night text-desert-night-fg">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 md:grid-cols-12 md:px-6 md:py-24">
        <div class="md:col-span-5">
          <p class="text-xs font-semibold uppercase tracking-widest text-desert-terracotta">Available for acquisition</p>
          <h2 class="mt-3 font-serif text-4xl leading-tight md:text-5xl">Own the name that defines Arizona waxing.</h2>
          <p class="mt-4 text-desert-night-fg/80">One registrant. Flexible structures for the right operator. Qualified notes get a direct reply.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="mailto:sales@desertrich.com?subject=Acquisition%20Inquiry%20%E2%80%94%20azwax.ing" class="inline-flex min-h-12 items-center justify-center rounded-full bg-desert-paper px-5 text-sm font-semibold text-desert-charcoal">
              sales@desertrich.com
            </a>
            <button type="button" data-copy-email class="inline-flex min-h-12 items-center justify-center rounded-full border border-desert-night-fg/30 px-5 text-sm font-medium">
              <span data-copy-label>Copy email</span>
            </button>
          </div>
        </div>
        <form id="inquiry-form" class="rounded-3xl bg-desert-paper p-5 text-desert-charcoal md:col-span-7 md:p-7">
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block text-sm font-medium">Name
              <input name="name" required autocomplete="name" class="mt-1.5 min-h-12 w-full rounded-2xl border border-desert-border bg-desert-sand px-3 text-base" />
            </label>
            <label class="block text-sm font-medium">Email
              <input name="email" type="email" required autocomplete="email" class="mt-1.5 min-h-12 w-full rounded-2xl border border-desert-border bg-desert-sand px-3 text-base" />
            </label>
            <label class="block text-sm font-medium">Intended use
              <select name="use" class="mt-1.5 min-h-12 w-full rounded-2xl border border-desert-border bg-desert-sand px-3 text-base">
                <option>Flagship salon</option>
                <option>Mobile / concierge</option>
                <option>Booking platform</option>
                <option>Academy</option>
                <option>Product line</option>
                <option>Other</option>
              </select>
            </label>
            <label class="block text-sm font-medium">Offer (optional)
              <input name="offer" autocomplete="off" placeholder="Range or discuss" class="mt-1.5 min-h-12 w-full rounded-2xl border border-desert-border bg-desert-sand px-3 text-base" />
            </label>
          </div>
          <label class="mt-4 block text-sm font-medium">Note
            <textarea name="note" rows="4" class="mt-1.5 w-full rounded-2xl border border-desert-border bg-desert-sand px-3 py-3 text-base" placeholder="City, timeline, and what you would build."></textarea>
          </label>
          <p id="inquiry-error" hidden class="mt-3 text-sm text-desert-terracotta">Add your name and a real email so the note can be answered.</p>
          <p id="inquiry-ok" hidden class="mt-3 text-sm text-desert-sage">Your mail app should open with the inquiry filled in. Send it to reach us.</p>
          <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center">
            <button type="submit" class="cta-primary min-h-12 rounded-full px-6 text-sm font-semibold">Send inquiry</button>
            <a href="mailto:sales@desertrich.com?subject=Acquisition%20Inquiry%20%E2%80%94%20azwax.ing&body=I%20would%20like%20to%20speak%20with%20the%20agent%20about%20azwax.ing." class="text-sm font-medium text-desert-sage underline-offset-4 hover:underline">Contact the agent instead</a>
          </div>
        </form>
      </div>
    </section>
  </main>
  <script is:inline>
    (function () {
      var buttons = document.querySelectorAll('#use-filters [data-filter]');
      var cards = document.querySelectorAll('#use-grid [data-tag]');
      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var tag = btn.getAttribute('data-filter');
          buttons.forEach(function (other) {
            var on = other === btn;
            other.setAttribute('aria-selected', on ? 'true' : 'false');
            other.className = 'min-h-12 shrink-0 rounded-full px-4 text-sm font-medium ' + (on ? 'bg-desert-charcoal text-desert-sand' : 'bg-desert-cream text-desert-sage');
          });
          cards.forEach(function (card) {
            var show = tag === 'All' || card.getAttribute('data-tag') === tag;
            card.classList.toggle('hidden', !show);
          });
        });
      });
    })();
  </script>
</MainLayout>
