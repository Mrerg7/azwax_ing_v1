---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="404 — Page Not Found | azwax.ing" path="/404/" noindex={true}>
  <main id="content" class="mx-auto flex min-h-[70vh] max-w-xl flex-col items-start justify-center px-4 py-24">
    <p class="font-serif text-7xl text-desert-terracotta">404</p>
    <h1 class="mt-4 font-serif text-3xl">That page is not on this name.</h1>
    <p class="mt-3 text-desert-sage">The address may have moved. The domain itself is still available.</p>
    <a href="/" class="cta-primary mt-8 inline-flex min-h-12 items-center rounded-full px-6 text-sm font-semibold">Return home</a>
  </main>
</MainLayout>
